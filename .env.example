# ====================================================================
# ActionOS · Amazon Bedrock Nova & OneWayFix Environment Configuration
# ====================================================================

# 1. AWS Credentials & Bedrock Model Settings
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# 2. ActionOS MCP Server & Web Settings
MCP_PORT=3001
MCP_SERVER_URL=http://localhost:3001/mcp
PORT=3000

# 3. Owner Dashboard Credentials
OWNER_PASSWORD=admin123

# 4. OneWayFix Mock & Production API Settings
ONEWAYFIX_MOCK=true
ONEWAYFIX_API_URL=https://api.onewayfix.com/v1
ONEWAYFIX_API_KEY=owf_test_secret_key_12345
MOCK_DATA_DIR=./data

